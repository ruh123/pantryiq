# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Environment / secrets
.env

# Data (raw dumps + warehouse files) — never commit; datasets live under data/raw/
data/*
*.duckdb
*.duckdb.wal
# ...except the hand-labeled gold set: it is irreplaceable human judgment and the
# ground truth behind the headline precision/recall metric, so it IS version-controlled.
!data/gold_labels/
!data/gram_reference.csv
!data/entity_overrides.csv

# IDE
.idea/

# macOS
.DS_Store

# Secrets — never commit tokens/keys/credentials (belt-and-braces beyond .env)
*token*.txt
*.pem
*.key
*.p12
*credentials*.json

# dbt
target/
dbt_packages/
logs/
.user.yml

# Airflow / Great Expectations working dirs (isolated dep groups, run locally)
airflow.db
airflow-webserver.pid
standalone_admin_password.txt
gx/uncommitted/
great_expectations/uncommitted/
